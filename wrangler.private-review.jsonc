{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chematlas-private-question-review",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chematlas-private-review",
      "database_id": "fe3f5e19-c470-4e5b-b83a-c49599508a85",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVIEW_IMAGES",
      "bucket_name": "chematlas-private-review-images"
    }
  ],
  "vars": {
    "CHEMATLAS_REVIEW_OWNER_EMAIL": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
