{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chematlas-student-private",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
